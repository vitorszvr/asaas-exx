# Configurações do Asaas (Sandbox por padrão)
ASAAS_ENV=sandbox
ASAAS_BASE_URL=https://api-sandbox.asaas.com
ASAAS_API_KEY=sua_chave_de_api_do_sandbox_aqui
ASAAS_WEBHOOK_TOKEN=defina_um_token_seguro_com_mais_de_32_caracteres_aleatorios

# URLs da Aplicação
PUBLIC_BASE_URL=http://localhost:8000
DB_PATH=pedidos.db

